    {
      "id": "sparktraits:excellent_physique",
      "tab": "TRAIT",
      "sourceModId": "sparktraits",
      "nameKey": "trait.sparktraits.excellent_physique.name",
      "summaryKey": "trait.sparktraits.excellent_physique.description",
      "pages": [
        {
          "blocks": [
            {
              "type": "paragraph",
              "text": "跑得更久，恢复更快。通用词条，但只会出现在体力有限的身份上，杀手这类能一直跑的身份抽不到。"
            },
            {
              "type": "section",
              "text": "效果",
              "tone": "info"
            },
            {
              "type": "bullet",
              "text": "体力上限翻倍：普通好人原本疾跑约 10 秒就会累，现在约 20 秒。"
            },
            {
              "type": "bullet",
              "text": "不跑的时候，体力恢复速度也翻倍。"
            },
            {
              "type": "section",
              "text": "建议",
              "tone": "good"
            },
            {
              "type": "bullet",
              "text": "被追时你能比别人跑得更久，遇险先拉开距离再想办法。"
            }
          ]
        }
      ],
      "ownerRoleIds": [],
      "requiredModIds": [
        "sparktraits"
      ],
      "color": "#7ED957",
      "order": 770
    }
  ]
