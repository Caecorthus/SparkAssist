{
  "entries": [
    {
      "id": "sparkwitch:kidnapper",
      "tab": "ROLE",
      "sourceModId": "sparkwitch",
      "nameKey": "announcement.role.kidnapper",
      "summaryKey": "guidebook.sparkassist.content.role.overview",
      "pages": [
        {
          "blocks": [
            {
              "type": "section",
              "text": "身份",
              "tone": "danger"
            },
            {
              "type": "bullet",
              "text": "绑架者属于杀手阵营，继承杀手的基础能力。"
            },
            {
              "type": "section",
              "text": "拖动",
              "tone": "info"
            },
            {
              "type": "bullet",
              "text": "直接瞄准 2 格内且视线无遮挡的尸体，按身份技能键开始拖动。"
            },
            {
              "type": "bullet",
              "text": "拖动中可在任意位置再次按身份技能键放下尸体；开始与放下都没有冷却，也不消耗任何资源。"
            },
            {
              "type": "bullet",
              "text": "每名绑架者同时只能拖动一具尸体，不能抢走其他绑架者正在拖动的尸体。"
            },
            {
              "type": "section",
              "text": "迷药",
              "tone": "danger"
            },
            {
              "type": "bullet",
              "text": "绑架者开局拥有 1 个迷药，但开局前 40 秒不能使用；迷药使用成功后进入 45 秒冷却。"
            },
            {
              "type": "bullet",
              "text": "对准任意普通存活玩家使用迷药即可劫持，不再按目标职业限制失败；劫持持续 30 秒。"
            },
            {
              "type": "bullet",
              "text": "被劫持者会持续跟随绑架者，并暂时失去攻击、使用物品、切换快捷栏和语音交流能力，同时看到黑屏提示。"
            },
            {
              "type": "bullet",
              "text": "绑架者按下潜行键可以提前结束劫持；目标死亡、离开游戏或回合结束时，劫持也会自动结束。"
            },
            {
              "type": "bullet",
              "text": "绑架者亲手杀死当前被自己劫持的玩家时，额外获得 100 金币。迷药也会在绑架者商店的毒药分类中以 50 金币出售。"
            },
            {
              "type": "section",
              "text": "验尸官伪装",
              "tone": "info"
            },
            {
              "type": "bullet",
              "text": "验尸官伪装成绑架者时，会临时获得 1 个迷药，并在商店中获得同样的 50 金币迷药条目。伪装解除后，临时迷药会被回收。"
            }
          ]
        },
        {
          "blocks": [
            {
              "type": "section",
              "text": "跟随与速度",
              "tone": "info"
            },
            {
              "type": "bullet",
              "text": "尸体会跟在绑架者身后约 1 格处。"
            },
            {
              "type": "bullet",
              "text": "拖动期间，绑架者的最终行走与疾跑速度倍率均变为 0.8；放下尸体或尸体被移除后恢复。"
            },
            {
              "type": "section",
              "text": "尸体限制",
              "tone": "danger"
            },
            {
              "type": "bullet",
              "text": "假死尸体无法被拖动；尝试拖动时会提示：TA 真的死了吗...？"
            },
            {
              "type": "bullet",
              "text": "裹尸袋、秃鹫与既有尸体清理流程仍正常处理拖动中的尸体。"
            }
          ]
        }
      ],
      "ownerRoleIds": [],
      "requiredModIds": [
        "sparkwitch"
      ],
      "color": "#9B59B6",
      "order": 420
    }
  ]
}
