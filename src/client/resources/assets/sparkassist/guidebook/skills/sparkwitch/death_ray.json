{
  "entries": [
    {
      "id": "sparkwitch:death_ray",
      "tab": "SKILL",
      "sourceModId": "sparkwitch",
      "nameKey": "skill.sparkwitch.death_ray.name",
      "summaryKey": "skill.sparkwitch.death_ray.description",
      "pages": [
        {
          "blocks": [
            {
              "type": "quote",
              "text": "杀意魔女专属技能"
            },
            {
              "type": "paragraph",
              "text": "10 秒内射出 3 道穿透射线，直线上的人会被一并处决。"
            },
            {
              "type": "section",
              "text": "效果",
              "tone": "money"
            },
            {
              "type": "bullet",
              "text": "按技能键（默认 G），消耗 100 魔力，进入 10 秒的射线状态，期间共有 3 发。"
            },
            {
              "type": "bullet",
              "text": "左键沿准心射出红色射线，最远 12 格。射线会穿过玩家，杀死直线上的每一个人，但会被墙壁等方块挡住；护盾可以挡下。"
            },
            {
              "type": "bullet",
              "text": "10 秒到了或 3 发打完后进入 60 秒冷却；开局另有 60 秒冷却。"
            },
            {
              "type": "section",
              "text": "使用建议",
              "tone": "good"
            },
            {
              "type": "bullet",
              "text": "你的魔力上限只有 150，攒够 100 再开。在走廊这类直线空间里，一发就能带走好几个人。"
            },
            {
              "type": "bullet",
              "text": "射线有红光和声响，一开火基本就暴露了，尽量一次把在场的人清干净。"
            }
          ]
        }
      ],
      "ownerRoleIds": [
        "sparkwitch:murderous_witch"
      ],
      "requiredModIds": [
        "sparkwitch"
      ],
      "color": "#C13838",
      "order": 170
    }
  ]
}
